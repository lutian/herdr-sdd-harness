#!/usr/bin/env node
/**
 * sddharness CLI — global workspace + init/validate
 */

import {
  copyFileSync,
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  statSync,
  writeFileSync,
} from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";
import { harnessHome } from "../lib/home.mjs";
import {
  addRepo,
  createWorkspace,
  listWorkspaces,
  readWorkspace,
  getCurrentName,
  releaseLock,
  removeRepo,
  requireCurrent,
  useWorkspace,
} from "../lib/workspace.mjs";
import { executeStart, formatStartPlan, planStart } from "../lib/boot.mjs";
import { formatUsage } from "../lib/quota.mjs";
import { checkWave, classifyBand, DEFAULT_QUOTA } from "../lib/quota.mjs";
import { EXECUTORS } from "../template/sddharness/scripts/runtime/provider.mjs";
import { readConfig } from "../template/sddharness/scripts/config.mjs";

const __dirname = dirname(fileURLToPath(import.meta.url));
const KIT_ROOT = resolve(__dirname, "..");
const TEMPLATE = join(KIT_ROOT, "template");

function usage() {
  console.log(`Usage:
  sddharness start [--print]
  sddharness unlock [nome]
  sddharness workspace create|list|use [nome]
  sddharness repo add|list|remove <path|id>
  sddharness init <destino>          # instala artefatos no repo (+ repo add se houver workspace)
  sddharness validate [destino]
  sddharness usage | quota
  sddharness config …

  install.sh <destino>  →  alias de init
`);
}

function isDir(p) {
  try {
    return statSync(p).isDirectory();
  } catch {
    return false;
  }
}

function ensureDir(p) {
  mkdirSync(p, { recursive: true });
}

function homeEnv() {
  return harnessHome(process.env);
}

function fail(msg, code = 1) {
  console.error(`[FAIL]  ${msg}`);
  process.exit(code);
}

function copyConservative(src, dest, skipped, created) {
  if (!existsSync(src)) return;
  const st = statSync(src);
  if (st.isDirectory()) {
    ensureDir(dest);
    for (const name of readdirSync(src)) {
      if (name === "node_modules" || name === ".git") continue;
      if (src === TEMPLATE && name === "agents") continue;
      copyConservative(join(src, name), join(dest, name), skipped, created);
    }
    return;
  }
  if (existsSync(dest)) {
    skipped.push(dest);
    return;
  }
  ensureDir(dirname(dest));
  copyFileSync(src, dest);
  created.push(dest);
}

function inferProjectName(dest) {
  if (existsSync(join(dest, "package.json"))) {
    try {
      const pkg = JSON.parse(readFileSync(join(dest, "package.json"), "utf8"));
      if (pkg.name) return pkg.name;
    } catch {
      /* ignore */
    }
  }
  const csproj = isDir(dest)
    ? readdirSync(dest).find((f) => f.endsWith(".csproj"))
    : null;
  if (csproj) return csproj.replace(/\.csproj$/, "");
  return dest.split(/[/\\]/).filter(Boolean).pop() || "seu-projeto";
}

function patchFeatureListProject(dest) {
  const flPath = join(dest, "sddharness", "feature_list.json");
  if (!existsSync(flPath)) return;
  try {
    const data = JSON.parse(readFileSync(flPath, "utf8"));
    if (data.project === "seu-projeto") {
      data.project = inferProjectName(dest);
      writeFileSync(flPath, JSON.stringify(data, null, 2) + "\n");
    }
  } catch {
    /* ignore */
  }
}

function chmodInit(dest) {
  const init = join(dest, "sddharness", "init.sh");
  if (!existsSync(init)) return;
  try {
    spawnSync("chmod", ["+x", init], { stdio: "ignore" });
  } catch {
    /* ignore */
  }
}

function installRepoArtifacts(dest) {
  if (!existsSync(TEMPLATE)) fail(`template não encontrado em ${TEMPLATE}`);
  ensureDir(dest);
  const skipped = [];
  const created = [];
  copyConservative(TEMPLATE, dest, skipped, created);
  for (const d of [
    "sddharness/docs",
    "sddharness/progress",
    "sddharness/scripts",
    "sddharness/specs",
    ".sddharness",
  ]) {
    ensureDir(join(dest, d));
  }
  patchFeatureListProject(dest);
  chmodInit(dest);
  return { skipped, created };
}

function registerIfWorkspace(dest) {
  try {
    const ws = requireCurrent(homeEnv());
    addRepo(ws, dest, { id: inferProjectName(dest) }, homeEnv());
    console.log(`[OK]    repo ligado ao workspace ${ws.name}`);
  } catch {
    /* sem workspace ativo */
  }
}

function cmdInit(destArg) {
  if (!destArg) {
    usage();
    process.exit(1);
  }
  const dest = resolve(destArg);
  const { skipped, created } = installRepoArtifacts(dest);
  registerIfWorkspace(dest);
  console.log(`[OK]    sddharness instalado em ${dest}`);
  console.log(`[OK]    arquivos criados: ${created.length}`);
  if (skipped.length) {
    console.log(`[WARN]  arquivos preservados (já existiam): ${skipped.length}`);
  }
  const validateScript = join(dest, "sddharness", "scripts", "validate-features.mjs");
  if (existsSync(validateScript)) {
    const r = spawnSync(process.execPath, [validateScript], {
      cwd: dest,
      encoding: "utf8",
    });
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
    if (r.status !== 0) {
      console.error("[FAIL]  validate-features falhou após init");
      process.exit(r.status ?? 1);
    }
  }
  console.log(`
Próximos passos:
  1. npm exec sddharness workspace create <nome>   (se ainda não tiver)
  2. node bin/sddharness start
     (abre o Herdr, o pane e o leader — sem /sddharness init)
`);
}

function cmdValidate(destArg) {
  const dest = resolve(destArg || process.cwd());
  const script = join(dest, "sddharness", "scripts", "validate-features.mjs");
  if (!existsSync(script)) fail(`não achei ${script}`);
  const r = spawnSync(process.execPath, [script], {
    cwd: dest,
    encoding: "utf8",
    stdio: "inherit",
  });
  process.exit(r.status ?? 1);
}

function cmdWorkspace(argv) {
  const [sub, name] = argv;
  const home = homeEnv();
  if (sub === "list") {
    const cur = (() => {
      try {
        return requireCurrent(home).name;
      } catch {
        return null;
      }
    })();
    const names = listWorkspaces(home);
    if (!names.length) {
      console.log("(nenhum workspace)");
      return;
    }
    for (const n of names) console.log(`${n === cur ? "*" : " "} ${n}`);
    return;
  }
  if (sub === "create") {
    if (!name) fail("usage: workspace create <nome>");
    const { created } = createWorkspace(name, home);
    console.log(created ? `[OK]    workspace ${name}` : `[OK]    workspace ${name} já existia`);
    return;
  }
  if (sub === "use") {
    if (!name) fail("usage: workspace use <nome>");
    useWorkspace(name, home);
    console.log(`[OK]    workspace ativo: ${name}`);
    return;
  }
  fail("usage: workspace create|list|use");
}

function cmdRepo(argv) {
  const [sub, target] = argv;
  const home = homeEnv();
  const ws = requireCurrent(home);
  if (sub === "list") {
    for (const r of ws.repos || []) console.log(`${r.id}\t${r.path}`);
    return;
  }
  if (sub === "add") {
    if (!target) fail("usage: repo add <path>");
    const dest = resolve(target);
    installRepoArtifacts(dest);
    const { repo } = addRepo(ws, dest, { id: inferProjectName(dest) }, home);
    console.log(`[OK]    repo ${repo.id} → ${repo.path}`);
    return;
  }
  if (sub === "remove") {
    if (!target) fail("usage: repo remove <id|path>");
    removeRepo(ws, target, home);
    console.log(`[OK]    repo removido: ${target}`);
    return;
  }
  fail("usage: repo add|list|remove");
}

function resolvedConfig(extra = {}) {
  return readConfig({
    home: homeEnv(),
    cwd: process.cwd(),
    ...extra,
  });
}

function cmdUnlock(nameArg) {
  const home = homeEnv();
  const name = nameArg || getCurrentName(home);
  if (!name) fail("nenhum workspace — sddharness unlock <nome>");
  releaseLock(name, home);
  console.log(`[OK]    lock removido: ${name}`);
}

function cmdStart(argv) {
  const printOnly = argv.includes("--print");
  const cfg = resolvedConfig();
  let plan;
  try {
    plan = planStart(cfg, {
      home: homeEnv(),
      cwd: process.cwd(),
    });
  } catch (err) {
    fail(err.message);
  }
  console.log(formatStartPlan(plan));
  if (printOnly) return;
  try {
    const status = executeStart(plan, {
      env: {
        ...process.env,
        SDDHARNESS_SESSION: plan.session,
        SDDHARNESS_BOOT_PROMPT: plan.bootPromptPath,
      },
    });
    process.exit(status);
  } catch (err) {
    fail(err.message);
  }
}

function probeFromEnv(executor, env) {
  const prefix = executor.toUpperCase();
  const sessionPct = env[`SDDHARNESS_${prefix}_SESSION_PCT`];
  const weeklyPct = env[`SDDHARNESS_${prefix}_WEEKLY_PCT`];
  const out = {};
  if (sessionPct != null && sessionPct !== "") out.sessionPct = Number(sessionPct);
  if (weeklyPct != null && weeklyPct !== "") out.weeklyPct = Number(weeklyPct);
  return out;
}

async function liveProbes(cfg) {
  const { createProviders } = await import(
    "../template/sddharness/scripts/herdr-agent.mjs"
  );
  const providers = createProviders();
  const quota = { ...DEFAULT_QUOTA, ...(cfg.quota || {}) };
  const probes = {};
  for (const name of EXECUTORS) {
    probes[name] = await providers[name].probe({ quota, env: process.env });
    const envP = probeFromEnv(name, process.env);
    if (envP.sessionPct != null) probes[name] = { ...probes[name], ...envP };
  }
  return probes;
}

async function cmdUsage() {
  const cfg = resolvedConfig();
  const probes = await liveProbes(cfg);
  const roleExecutors = {};
  for (const [role, agent] of Object.entries(cfg.agents || {})) {
    roleExecutors[role] = agent.executor || "claude";
  }
  const { rows } = checkWave(probes, roleExecutors, cfg.quota);
  for (const row of rows) {
    if (!row.band || row.band === "ok") {
      row.band = classifyBand(probes[row.executor], cfg.quota);
    }
  }
  const missing = EXECUTORS.filter(
    (e) => !rows.some((r) => r.executor === e)
  );
  for (const executor of missing) {
    rows.push({
      executor,
      band: classifyBand(probes[executor], cfg.quota),
      roles: [],
      sessionPct: probes[executor]?.sessionPct,
      weeklyPct: probes[executor]?.weeklyPct,
    });
  }
  const snap = join(homeEnv(), "quota.json");
  ensureDir(homeEnv());
  writeFileSync(
    snap,
    JSON.stringify({ at: new Date().toISOString(), probes, rows }, null, 2) + "\n"
  );
  process.stdout.write(formatUsage(rows));
}

function cmdConfig(argv) {
  const script = join(TEMPLATE, "sddharness", "scripts", "config.mjs");
  const r = spawnSync(process.execPath, [script, ...argv], {
    cwd: process.cwd(),
    stdio: "inherit",
    env: { ...process.env, SDDHARNESS_HOME: homeEnv() },
  });
  process.exit(r.status ?? 1);
}

const argv = process.argv.slice(2);
const [cmd, ...rest] = argv;

switch (cmd) {
  case "init":
    cmdInit(rest[0]);
    break;
  case "validate":
    cmdValidate(rest[0]);
    break;
  case "workspace":
    cmdWorkspace(rest);
    break;
  case "repo":
    cmdRepo(rest);
    break;
  case "start":
    cmdStart(rest);
    break;
  case "unlock":
    cmdUnlock(rest[0]);
    break;
  case "usage":
  case "quota":
    cmdUsage().catch((err) => fail(err.message));
    break;
  case "config":
    cmdConfig(rest);
    break;
  case "-h":
  case "--help":
  case "help":
    usage();
    process.exit(0);
    break;
  case undefined:
    usage();
    process.exit(1);
    break;
  default:
    console.error(`[FAIL]  comando desconhecido: ${cmd}`);
    usage();
    process.exit(1);
}
