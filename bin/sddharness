#!/usr/bin/env node
/**
 * sddharness CLI — init | validate
 *
 * Usage:
 *   sddharness init <destino>
 *   sddharness validate [destino]
 */

import {
  copyFileSync,
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  statSync,
  writeFileSync,
} from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const __dirname = dirname(fileURLToPath(import.meta.url));
const KIT_ROOT = resolve(__dirname, "..");
const TEMPLATE = join(KIT_ROOT, "template");

function usage() {
  console.log(`Usage:
  sddharness init <destino>
  sddharness validate [destino]

  install.sh <destino>  →  alias de init
`);
}

function isDir(p) {
  try {
    return statSync(p).isDirectory();
  } catch {
    return false;
  }
}

function ensureDir(p) {
  mkdirSync(p, { recursive: true });
}

/**
 * Copy template → dest without overwriting existing files.
 * Directories are merged; files that already exist are skipped.
 */
function copyConservative(src, dest, skipped, created) {
  if (!existsSync(src)) return;
  const st = statSync(src);
  if (st.isDirectory()) {
    ensureDir(dest);
    for (const name of readdirSync(src)) {
      if (name === "node_modules" || name === ".git") continue;
      // Canonical agent bodies stay in the kit; targets get .claude/.cursor wrappers only.
      if (src === TEMPLATE && name === "agents") continue;
      copyConservative(join(src, name), join(dest, name), skipped, created);
    }
    return;
  }
  if (existsSync(dest)) {
    skipped.push(dest);
    return;
  }
  ensureDir(dirname(dest));
  copyFileSync(src, dest);
  created.push(dest);
}

function inferProjectName(dest) {
  if (existsSync(join(dest, "package.json"))) {
    try {
      const pkg = JSON.parse(readFileSync(join(dest, "package.json"), "utf8"));
      if (pkg.name) return pkg.name;
    } catch {
      /* ignore */
    }
  }
  const csproj = readdirSync(dest).find((f) => f.endsWith(".csproj"));
  if (csproj) return csproj.replace(/\.csproj$/, "");
  return dest.split(/[/\\]/).filter(Boolean).pop() || "seu-projeto";
}

function patchFeatureListProject(dest) {
  const flPath = join(dest, "sddharness", "feature_list.json");
  if (!existsSync(flPath)) return;
  try {
    const data = JSON.parse(readFileSync(flPath, "utf8"));
    if (data.project === "seu-projeto") {
      data.project = inferProjectName(dest);
      writeFileSync(flPath, JSON.stringify(data, null, 2) + "\n");
    }
  } catch {
    /* ignore */
  }
}

function chmodInit(dest) {
  const init = join(dest, "sddharness", "init.sh");
  if (!existsSync(init)) return;
  try {
    spawnSync("chmod", ["+x", init], { stdio: "ignore" });
  } catch {
    /* ignore */
  }
}

function cmdInit(destArg) {
  if (!destArg) {
    usage();
    process.exit(1);
  }
  const dest = resolve(destArg);
  if (!existsSync(TEMPLATE)) {
    console.error(`[FAIL] template não encontrado em ${TEMPLATE}`);
    process.exit(1);
  }
  ensureDir(dest);

  const skipped = [];
  const created = [];
  copyConservative(TEMPLATE, dest, skipped, created);

  for (const d of [
    "sddharness/docs",
    "sddharness/progress",
    "sddharness/scripts",
    "sddharness/specs",
    ".sddharness",
  ]) {
    ensureDir(join(dest, d));
  }

  patchFeatureListProject(dest);
  chmodInit(dest);

  console.log(`[OK]    sddharness instalado em ${dest}`);
  console.log(`[OK]    arquivos criados: ${created.length}`);
  if (skipped.length) {
    console.log(`[WARN]  arquivos preservados (já existiam): ${skipped.length}`);
  }

  const validateScript = join(
    dest,
    "sddharness",
    "scripts",
    "validate-features.mjs"
  );
  if (existsSync(validateScript)) {
    const r = spawnSync(process.execPath, [validateScript], {
      cwd: dest,
      encoding: "utf8",
    });
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
    if (r.status !== 0) {
      console.error("[FAIL]  validate-features falhou após init");
      process.exit(r.status ?? 1);
    }
  }

  console.log(`
Próximos passos:
  1. /sddharness filldocs  (ou preencha sddharness/docs/*)
  2. Autentique o MCP Atlassian (Jira) no Cursor
  3. /sddharness init   — fluxo amigável
`);
}

function cmdValidate(destArg) {
  const dest = resolve(destArg || process.cwd());
  const script = join(dest, "sddharness", "scripts", "validate-features.mjs");
  if (!existsSync(script)) {
    console.error(`[FAIL]  não achei ${script}`);
    process.exit(1);
  }
  const r = spawnSync(process.execPath, [script], {
    cwd: dest,
    encoding: "utf8",
    stdio: "inherit",
  });
  process.exit(r.status ?? 1);
}

const [cmd, arg] = process.argv.slice(2);
switch (cmd) {
  case "init":
    cmdInit(arg);
    break;
  case "validate":
    cmdValidate(arg);
    break;
  case "-h":
  case "--help":
  case "help":
  case undefined:
    usage();
    process.exit(cmd ? 0 : 1);
    break;
  default:
    console.error(`[FAIL]  comando desconhecido: ${cmd}`);
    usage();
    process.exit(1);
}
